.col-12
  .table-responsive
    %table.table.table-hover.table-cards.table-cards--stacked-actions
      %thead
        %tr
          %th= t('parts.recurring_cash_flows.created_on')
          %th= t('parts.cash_flows.from_to')
          %th= t('common.amount')
          %th= t('common.next_transfer')
          %th= RecurringCashFlow.human_attribute_name(:frequency)
          %th
      %tbody
        - recurring_cash_flows.each do |rcf|
          %tr{ id: "recurring_cash_flow_#{rcf.id}" }
            %td.cell-desktop= l(rcf.created_at.to_date, format: :long)
            %td.cell-main
              = rcf.from_account.name
              = t(:arrow)
              = rcf.to_account.name
            %td.cell-amount= rcf.decorate.amount
            %td.cell-date= l(rcf.next_transfer_on.to_date, format: :long)
            %td.cell-meta= rcf.decorate.frequency
            %td.span2.actions.cell-actions
              = link_to perform_transfer_recurring_cash_flow_path(rcf), class: 'btn btn-success btn-sm', method: :post, title: t('parts.recurring_cash_flows.perform_transfer') do
                = fa_icon "plus"
              = link_to move_to_next_transfer_recurring_cash_flow_path(rcf), class: 'btn btn-outline-secondary btn-sm', method: :put, title: t('parts.recurring_cash_flows.move_to_next_transfer') do
                = fa_icon "forward"
              = link_to edit_recurring_cash_flow_path(rcf), class: 'btn btn-outline-secondary btn-edit btn-sm', title: t('common.edit') do
                = fa_icon "pencil"
              = link_to recurring_cash_flow_path(rcf), class: 'btn btn-outline-secondary btn-row-danger btn-delete btn-sm', method: :delete, data: { confirm: t('parts.recurring_cash_flows.delete_confirm', from: rcf.from_account.name, to: rcf.to_account.name) }, title: t('common.destroy') do
                = fa_icon "trash", "aria-hidden": "true"
                %span.visually-hidden= t('common.destroy')
