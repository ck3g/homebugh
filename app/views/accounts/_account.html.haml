.accounts-list-item
  .accounts-list-left
    %span.accounts-list-name= account.name
    %span.accounts-list-currency-label= account.decorate.unit
  .accounts-list-right
    %span.accounts-list-balance{class: ("zero-balance" if account.funds.to_f.zero?)}
      = account.decorate.amount
    .accounts-list-actions
      = link_to edit_account_path(account), title: t('common.edit'), class: "btn btn-outline-secondary btn-sm", data: { bs_toggle: 'tooltip' } do
        = fa_icon "pencil"
      - if account.funds.to_f.zero?
        = link_to account, data: { confirm: t('parts.accounts.archive_confirm', name: account.name), bs_toggle: 'tooltip' }, method: :delete, title: t('common.archive'), class: "btn btn-outline-secondary btn-sm btn-row-danger" do
          = fa_icon "archive", "aria-hidden": "true"
          %span.visually-hidden= t('common.archive')
      - else
        = link_to new_cash_flow_path, title: "#{t('parts.accounts.account_not_empty')} #{t('parts.cash_flows.new_cash_flows')}", class: "btn btn-outline-secondary btn-sm", data: { bs_toggle: 'tooltip' } do
          = fa_icon "retweet"
