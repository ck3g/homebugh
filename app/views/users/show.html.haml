= render 'shared/sub_navbar_widget',
  title_content: t('parts.users.profile')

.card-panels
  .row
    .col-md-6
      %fieldset
        %legend= t("parts.users.profile_information")
        %div
          .profile-info
            .profile-item
              %strong= t("parts.users.email")
              %span= current_user.email
            .profile-item
              %strong= t("parts.users.member_since")
              %span= l(current_user.created_at, format: :long)
            - if @user_stats[:first_transaction_date]
              .profile-item
                %strong= t("parts.users.first_transaction")
                %span= l(@user_stats[:first_transaction_date], format: :long)
            - else
              .profile-item
                %strong= t("parts.users.first_transaction")
                %span.text-muted= t("parts.users.not_yet_created")

    .col-md-6
      %fieldset
        %legend= t("parts.users.account_statistics")
        %div
          .profile-stats
            .stat-item
              %span.stat-number= @user_stats[:accounts_count]
              %span.stat-label= t("parts.users.stats_accounts")
            .stat-item
              %span.stat-number= @user_stats[:transactions_count]
              %span.stat-label= t("parts.users.stats_transactions")
            .stat-item
              %span.stat-number= @user_stats[:categories_count]
              %span.stat-label= t("parts.users.stats_categories")
            .stat-item
              %span.stat-number= @user_stats[:budgets_count]
              %span.stat-label= t("parts.users.stats_budgets")
            .stat-item
              %span.stat-number= @user_stats[:currencies_count]
              %span.stat-label= t("parts.users.stats_currencies")

  .row
    .col-md-12
      %fieldset
        %legend= t("parts.users.account_actions")
        %div
          %div
            = link_to t("parts.users.edit_profile"), edit_user_registration_path, class: "btn btn-primary"

  -# Kept apart from everyday actions so it is never hit by mistake
  .row
    .col-md-12
      %section.profile-danger-zone{ "aria-labelledby": "danger-zone-title" }
        %h3#danger-zone-title= t("parts.users.danger_zone")
        %p= t("parts.users.danger_zone_description")
        = link_to t("parts.users.delete"), users_delete_path, class: "btn btn-outline-danger"
