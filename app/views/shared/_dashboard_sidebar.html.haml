%div.dashboard-sidebar#dashboard-sidebar
  %nav.sidebar-nav
    %ul.nav.flex-column
      %li.nav-item{class: ("active" if controller_name == 'dashboard')}
        = link_to dashboard_path, title: "Dashboard", "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-dashboard
          %span Dashboard

      %li.nav-item{class: ("active" if controller_name == 'transactions')}
        = link_to transactions_path, title: t("main_menu.transactions"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-exchange
          %span= t("main_menu.transactions")

      %li.nav-item{class: ("active" if controller_name == 'recurring_payments')}
        = link_to recurring_payments_path, title: t("main_menu.recurring_payments"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-repeat
          %span= t("main_menu.recurring_payments")

      %li.nav-item{class: ("active" if controller_name == 'cash_flows')}
        = link_to cash_flows_path, title: t("main_menu.cash_flows"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-money
          %span= t("main_menu.cash_flows")

      %li.nav-item{class: ("active" if controller_name == 'recurring_cash_flows')}
        = link_to recurring_cash_flows_path, title: t("main_menu.recurring_cash_flows"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-calendar
          %span= t("main_menu.recurring_cash_flows")

      %li.nav-item{class: ("active" if controller_name == 'accounts')}
        = link_to accounts_path, title: t("main_menu.accounts"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-credit-card
          %span= t("main_menu.accounts")

      %li.nav-item{class: ("active" if controller_name == 'categories')}
        = link_to categories_path, title: t("main_menu.categories"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-tags
          %span= t("main_menu.categories")

      %li.nav-item{class: ("active" if controller_name == 'budgets')}
        = link_to budgets_path, title: t("main_menu.budgets"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-calculator
          %span= t("main_menu.budgets")

      %li.nav-item{class: ("active" if controller_name == 'statistics')}
        = link_to statistics_path, title: t("main_menu.statistics"), "data-bs-toggle" => "tooltip", "data-bs-placement" => "right", class: "nav-link" do
          %i.fa.fa-bar-chart
          %span= t("main_menu.statistics")

    -# On phones the topbar links move here, within thumb reach
    %ul.nav.flex-column.sidebar-account.d-md-none
      %li.nav-item{class: ("active" if controller_name == 'users')}
        = link_to users_profile_path, class: "nav-link" do
          %i.fa.fa-user{ "aria-hidden": "true" }
          %span= t("main_menu.profile")
      %li.nav-item
        = link_to url_for(locale: inverse_locale), class: "nav-link" do
          = image_tag("flags/#{inverse_locale}.png", class: "flag-icon", alt: "")
          %span= t("locales.#{inverse_locale}")
      %li.nav-item
        = link_to destroy_user_session_path, method: :delete, class: "nav-link" do
          %i.fa.fa-sign-out{ "aria-hidden": "true" }
          %span= t("parts.auth.sign_out")

  %div.sidebar-toggle-footer.d-none.d-md-block
    %button.sidebar-collapse-btn{type: "button"}
      %i.fa.fa-angle-left
